---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="home-page">
    <div class="background-glow mesh-1"></div>
    <div class="background-glow mesh-2"></div>

    <header class="home-header">
      <div class="logo">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="logo-icon">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5"></path>
          <path d="M2 12l10 5 10-5"></path>
        </svg>
        <span>AstroAuth</span>
      </div>
      <a href="/login" class="header-link">Sign in</a>
    </header>

    <section class="hero">
      <span class="badge">Supabase Auth · Turnstile · Server-side rendered</span>

      <h1>Astro Users</h1>

      <p class="hero-subtitle">
        A drop-in authentication layer for Astro. Sign up, sign in, and protected
        sessions — all handled server-side, with bot protection built in.
      </p>

      <div class="hero-actions">
        <a href="/signup" class="btn btn-primary">Start now</a>
        <a href="/login" class="btn btn-secondary">Sign in</a>
      </div>

      <ul class="feature-row">
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Secure sessions
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          CAPTCHA protected
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polyline>
          </svg>
          Zero client secrets
        </li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  .home-page {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: var(--color-bg);
    color: var(--color-text-base);
    font-family: var(--font-family);
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Decorative Background Glows */
  .background-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.15;
    pointer-events: none;
    z-index: 0;
  }

  .mesh-1 {
    top: -10%;
    left: -10%;
    background: var(--gradient-mesh-primary);
  }

  .mesh-2 {
    bottom: -10%;
    right: -10%;
    background: var(--gradient-mesh-accent);
  }

  /* Header */
  .home-header {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.5px;
    background: var(--gradient-logo);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .logo-icon {
    width: 24px;
    height: 24px;
    stroke: var(--color-primary-light);
  }

  .header-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .header-link:hover {
    color: var(--color-text-base);
  }

  /* Hero */
  .hero {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 24px;
    max-width: 720px;
    margin: 0 auto;
    padding: 64px 24px 96px;
    box-sizing: border-box;
  }

  .badge {
    background: var(--tint-primary);
    color: var(--color-primary-lighter);
    border: 1px solid var(--tint-primary-border);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -2px;
    background: var(--gradient-heading-strong);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    margin: 0;
    max-width: 540px;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* Call to action buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-slow);
  }

  .btn-primary {
    background: var(--gradient-brand);
    border: 1px solid transparent;
    color: var(--color-text-strong);
    box-shadow: var(--shadow-btn);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-btn-hover);
    filter: brightness(1.05);
  }

  .btn-primary:active {
    transform: translateY(1px);
  }

  .btn-secondary {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-soft);
    color: var(--color-text-base);
  }

  .btn-secondary:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-strong);
  }

  .btn-secondary:active {
    transform: translateY(1px);
  }

  /* Feature strip */
  .feature-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }

  .feature-row li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 8px 16px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .feature-row svg {
    width: 15px;
    height: 15px;
    color: var(--color-accent-soft);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 40px 24px 72px;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';

const url = new URL(Astro.request.url);
const email = url.searchParams.get('email') || '';
const emailMessage = email ? `We've sent a verification link to ${email}.` : "We've sent a verification link to your email address.";
---

<Layout>
  <main class="check-email-page">
    <div class="background-glow mesh-1"></div>
    <div class="background-glow mesh-2"></div>
    <section class="check-email-card">
      <div class="email-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <path d="m22 6-10 7L2 6"></path>
        </svg>
      </div>
      <h1>Check your email</h1>
      <p>{emailMessage}</p>
      <p class="subtitle">Open the email we just sent and click the verification link to finish setting up your account.</p>
      <a href="/login" class="secondary-btn">Back to login</a>
    </section>
  </main>
</Layout>

<style>
  .check-email-page {
    position: relative;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px;
    background-color: var(--color-bg);
  }

  .background-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }

  .mesh-1 {
    top: -10%;
    left: -10%;
    background: var(--gradient-mesh-primary);
  }

  .mesh-2 {
    bottom: -10%;
    right: -10%;
    background: var(--gradient-mesh-accent);
  }

  .check-email-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 520px;
    background: var(--color-card-bg-solid);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-3xl);
    padding: 44px;
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    text-align: center;
    color: var(--color-text-base);
  }

  .email-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 28px;
    display: grid;
    place-items: center;
    border-radius: 22px;
    background: var(--tint-primary-weak);
    border: 1px solid var(--tint-primary-border-strong);
  }

  .email-icon svg {
    width: 32px;
    height: 32px;
    stroke: var(--color-primary-soft);
  }

  .check-email-card h1 {
    margin: 0 0 18px;
    font-size: 2rem;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-text-strong);
  }

  .check-email-card p {
    margin: 0 auto;
    max-width: 380px;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-dim);
  }

  .check-email-card .subtitle {
    margin-top: 16px;
    color: var(--color-text-faint);
  }

  .secondary-btn {
    display: inline-flex;
    margin-top: 28px;
    padding: 14px 24px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-soft);
    background: transparent;
    color: var(--color-text-base);
    text-decoration: none;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .secondary-btn:hover {
    background: var(--tint-accent-hover);
    border-color: var(--tint-accent-border-strong);
  }
</style>
